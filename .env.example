# ==============================================================
# SENTINEL X — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to .env and supply your environment-specific values.
# NEVER commit your real .env file or production secret credentials to version control.

# --------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (OPTIONAL)
# --------------------------------------------------------------
# Required for live server-side Tier-3 AI analyst generation.
# If omitted, the deterministic offline security analyst engine is used.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# --------------------------------------------------------------
# 2. RUNTIME HOST CONFIGURATION
# --------------------------------------------------------------
# The hosted application URL (e.g., https://your-domain.run.app or http://localhost:3000)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --------------------------------------------------------------
# 3. FIREBASE AUTHENTICATION CONFIGURATION (OPTIONAL)
# --------------------------------------------------------------
# To connect SENTINEL X to your Google Firebase project:
# 1. Create a project at https://console.firebase.google.com
# 2. In Firebase Console, go to Authentication > Sign-in method and enable "Email/Password".
# 3. In Project Settings > General > Your Apps, register a Web App (</>) and copy the config values below.
# 4. Under Authentication > Settings > Authorized Domains, add your deployment domain (e.g. localhost or Cloud Run URL).
# Note: If these VITE_FIREBASE_* variables are not provided, SENTINEL X automatically
# operates with its built-in cryptographically secured Sovereign Auth Engine (PBKDF2/SHA-512).

VITE_FIREBASE_API_KEY="AIzaSy_YOUR_FIREBASE_API_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
